# ClarityTrack environment variables
# Copy this file to `.env` in the project root:
#   cp claritytrack-env-variables.env .env

# Required for signed login cookies
SESSION_SECRET=19ff85a3bcdf16f822e3e1d8fdbbcca637d6df870bd08c9f2259f257c6016da7

# Required to create the first Super Admin
SETUP_SECRET=d71fabca4044ed8abb13950a15fd59772e117b9d8520c6bd

# Optional — password reset emails via Resend
RESEND_API_KEY=
EMAIL_FROM="ClarityTrack <onboarding@resend.dev>"

# Optional — where store.json and uploads live (defaults to ./data)
# DATA_DIR=/absolute/path/to/data

# Optional — force Secure cookies (1) or allow HTTP cookies (0)
COOKIE_SECURE=0

# Optional — HTTP port for npm start (dev already uses 43123)
# PORT=43123
