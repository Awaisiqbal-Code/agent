# Copy to .env and fill in values for local development.
# On Cursor publish, set these in the app Secrets form (do not commit .env).

# Required for signed login cookies (use a long random string)
SESSION_SECRET=replace-with-a-long-random-secret

# Required to create the first Super Admin (platform owner)
SETUP_SECRET=replace-with-a-long-setup-secret

# Optional — password reset emails via Resend
RESEND_API_KEY=
EMAIL_FROM=ClarityTrack <onboarding@resend.dev>

# Optional — where store.json and uploads live (defaults to ./data)
# DATA_DIR=/absolute/path/to/data

# Optional — force Secure cookies (1) or allow HTTP cookies (0)
# COOKIE_SECURE=0

# Optional — HTTP port for `npm start` (dev script already uses 43123)
# PORT=43123
